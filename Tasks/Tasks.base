filters:
  and:
    - type == "task"
    - file.folder == "Tasks"
formulas:
  rank: if(priority == "high", 1, if(priority == "normal", 2, 3))
properties:
  file.name:
    displayName: Task
  note.project:
    displayName: Project or area
  note.task-status:
    displayName: Status
  note.priority:
    displayName: Priority
  note.kind:
    displayName: Kind
  note.effort:
    displayName: Effort
  note.decision:
    displayName: Decision
  note.due:
    displayName: Deadline
  note.when:
    displayName: Planned
  note.owner:
    displayName: Whose move
  note.depends-on:
    displayName: Depends on
  note.parent:
    displayName: Goal
  note.done:
    displayName: Done
  note.updated:
    displayName: Updated
views:
  - type: table
    name: Board
    filters:
      and:
        - note["task-status"] != "done"
        - note["task-status"] != "dropped"
        - note["task-status"] != "someday"
        - note["task-status"] != "inbox"
        - note.kind != "reminder"
    groupBy:
      property: project
      direction: ASC
    order:
      - file.name
      - task-status
      - parent
      - priority
      - effort
      - when
      - due
      - depends-on
    sort:
      - property: formula.rank
        direction: ASC
      - property: due
        direction: ASC
    columnSize:
      file.name: 575
  - type: table
    name: Deadlines
    filters:
      and:
        - note["task-status"] != "done"
        - note["task-status"] != "dropped"
        - note["task-status"] != "someday"
        - note.kind != "reminder"
        - not:
            - due.isEmpty()
    order:
      - file.name
      - due
      - project
      - task-status
      - priority
    sort:
      - property: due
        direction: ASC
  - type: table
    name: Reminders
    filters:
      and:
        - note.kind == "reminder"
        - note["task-status"] != "done"
        - note["task-status"] != "dropped"
    order:
      - file.name
      - when
      - task-status
    sort:
      - property: when
        direction: ASC
  - type: table
    name: Done
    filters:
      and:
        - note["task-status"] == "done"
    order:
      - file.name
      - done
      - project
    sort:
      - property: done
        direction: DESC
  - type: table
    name: Here
    filters:
      and:
        - file.hasLink(this.file)
        - note["task-status"] != "done"
        - note["task-status"] != "dropped"
        - note["task-status"] != "someday"
    order:
      - file.name
      - task-status
      - parent
      - priority
      - when
      - due
      - depends-on
    sort:
      - property: formula.rank
        direction: ASC
      - property: due
        direction: ASC
